{
    "name": "@erankushpatil/anky-ui",
    "version": "0.1.1",
    "description": "React AI UI primitives for inline streaming edits, diffs, ghost text and floating action palettes.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "keywords": [
      "ai ui library",
      "inline ai",
      "ambient ai",
      "copilot ui components",
      "shadcn ai",
      "react inline diff streaming",
      "cursor-like inline prompt react",
      "ghost text autocomplete textarea",
      "floating ai action palette",
      "undo redo ai state react",
      "nextjs generative ui",
      "headless ai primitives",
      "tailwind ai components",
      "radix floating ai toolbar"
    ],
    "license": "ISC",
    "author": "Ankush Patil",
    "homepage": "https://github.com/ErAnkushPatil/anky-ui/tree/main/packages/core#readme",
    "repository": {
      "type": "git",
      "url": "git+https://github.com/ErAnkushPatil/anky-ui.git",
      "directory": "packages/core"
    },
    "bugs": {
      "url": "https://github.com/ErAnkushPatil/anky-ui/issues"
    },
    "publishConfig": {
      "access": "public"
    },
    "files": ["dist", "README.md", "LICENSE"],
    "sideEffects": false,
    "scripts": {
      "build": "tsup src/index.ts --format cjs,esm --dts",
      "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
      "test": "vitest run",
      "typecheck": "tsc -p tsconfig.json",
      "prepublishOnly": "pnpm run build"
    },
    "dependencies": {
      "@floating-ui/react": "^0.27.0"
    },
    "devDependencies": {
      "@testing-library/react": "^16.3.3",
      "jsdom": "^29.1.1",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "tsup": "^9.0.0",
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "peerDependencies": {
      "react": "^18.0.0 || ^19.0.0",
      "react-dom": "^18.0.0 || ^19.0.0"
    }
  }